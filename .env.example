# Copie ce fichier en ".env" puis remplace TOUTES les valeurs.
# Générer un secret : openssl rand -hex 24

# Compte PostgreSQL utilisé par N8N et par les workflows
POSTGRES_USER=persona_app
POSTGRES_PASSWORD=change_me

# Clé qui chiffre les credentials stockés dans N8N. À garder : la perdre = credentials illisibles.
N8N_ENCRYPTION_KEY=change_me

# Adresse expéditrice des mails (doit correspondre au compte SMTP)
SMTP_FROM=change_me@example.com
