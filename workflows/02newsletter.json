    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT u.id, u.email, p.topics, p.language, p.custom_prompt, p.timezone\nFROM users u\nJOIN preferences p ON p.user_id = u.id\nWHERE u.unsubscribed = false\n  AND u.consent_at IS NOT NULL\n  AND p.send_time IS NOT NULL\n  AND (now() AT TIME ZONE p.timezone)::time >= p.send_time\n  AND (now() AT TIME ZONE p.timezone)::time <  p.send_time + interval '5 minutes'\n  AND NOT EXISTS (\n    SELECT 1 FROM sent_log s\n    WHERE s.user_id = u.id\n      AND (s.sent_at AT TIME ZONE p.timezone)::date = (now() AT TIME ZONE p.timezone)::date\n  );",
        "options": {}
