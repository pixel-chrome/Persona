    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Nœud Postgres « Enregistrer code » (Execute Query)\n-- Query Parameters : {{ [$json.email, $json.code_hash, $json.session_hash] }}\n-- Anti-spam : le WHERE refuse de remplacer un code créé il y a moins d'1 minute (0 ligne renvoyée).\nINSERT INTO login_codes (email, code_hash, session_hash, expires_at, attempts, created_at)\nVALUES ($1, $2, $3, now() + interval '10 minutes', 0, now())\nON CONFLICT (email) DO UPDATE\n  SET code_hash    = EXCLUDED.code_hash,\n      session_hash = EXCLUDED.session_hash,\n      expires_at   = EXCLUDED.expires_at,\n      attempts     = 0,\n      created_at   = now()\n  WHERE login_codes.created_at < now() - interval '1 minute'\nRETURNING email;\n",
        "options": {
          "queryReplacement": "={{ [$json.email, $json.code_hash, $json.session_hash] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        880,
        -416
      ],
      "id": "58cbb42e-0809-49c0-8d25-a0d166033402",
      "name": "Enregistrer code",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "BXcRV2jAUKnfoJgN",
          "name": "Postgres persona"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Nœud Code « Générer code » — JavaScript, mode « Run Once for Each Item »\n// Nécessite NODE_FUNCTION_ALLOW_BUILTIN=crypto (déjà dans docker-compose.yml)\nconst crypto = require('crypto');\nconst sha256 = (s) => crypto.createHash('sha256').update(s).digest('hex');\nconst code = String(crypto.randomInt(0, 1000000)).padStart(6, '0');   // 000000 à 999999\nreturn { json: {\n  email: $json.email,\n  code,                                   // en clair : uniquement pour le mail\n  code_hash: sha256(code),\n  session_hash: sha256($json.sessionId),  // lie le code à cette conversation\n} };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        -416
      ],
      "id": "67054f4b-2f31-402b-a42b-09fdf62ce06f",
      "name": "Générer code"
    },
